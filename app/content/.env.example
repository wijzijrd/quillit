PORT=3004
DB_PATH=./quillit-content.db
JWT_SECRET=replace-with-a-long-random-string
# Shared secret used both as a server (incoming internal RPC calls from svc)
# and a client (calls to svc's internal RPC service for membership checks);
# must match svc's INTERNAL_RPC_SECRET. Generate with: openssl rand -hex 32
INTERNAL_RPC_SECRET=replace-with-a-long-random-string

# MinIO — optional for native dev; entry body/image storage is disabled
# (Create/Update/UploadImage fail loud) when MINIO_ENDPOINT is unset.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=quillit
MINIO_SECRET_KEY=replace-with-strong-password
MINIO_BUCKET=quillit
MINIO_USE_SSL=false
