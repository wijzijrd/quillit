PORT=3000
DB_PATH=./quillit.db
AUTH_SERVICE_URL=http://localhost:3002
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
SEED_ADMIN_EMAIL=admin@quillit.dev
SEED_ADMIN_PASSWORD=changeme
# Shared secret used both as a client (calls to content's internal RPC
# service) and a server (incoming internal RPC calls from content); must
# match content's INTERNAL_RPC_SECRET. Generate with: openssl rand -hex 32
INTERNAL_RPC_SECRET=replace-with-a-long-random-string
