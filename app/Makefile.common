# Shared targets for app/{svc,auth,content,messaging}. Each service's own
# Makefile sets BINARY and SETUP_HINT, defines its own check-env, then
# includes this file — the services validate .env differently (svc checks
# JWT_SECRET format, others just check the file exists), so check-env stays
# per-service rather than being parameterized here.
#
# DB_PATH defaults to svc's own .env default; a service whose DB file is
# named differently (see its .env.example) should set DB_PATH ?= ... in its
# own Makefile before the include, the same way BINARY/SETUP_HINT are set.
DB_PATH ?= ./quillit.db

.PHONY: dev build build-linux setup swagger migrate-up migrate-status help

setup:          ## Copy .env.example → .env (skips if already exists)
	@test -f .env && echo ".env already exists, skipping" \
		|| (cp .env.example .env && echo "Created .env — edit $(SETUP_HINT) before running")

dev: check-env  ## Run dev server (loads .env automatically)
	@export $$(cat .env | xargs) && go run .

swagger:        ## Regenerate Swagger docs
	swag init --parseDependency --parseInternal

migrate-up:      ## Apply pending goose migrations to DB_PATH
	go tool goose -dir internal/db/migrations sqlite3 $(DB_PATH) up

migrate-status:  ## Show goose migration status for DB_PATH
	go tool goose -dir internal/db/migrations sqlite3 $(DB_PATH) status

build:          ## Compile binary for current OS/arch (local dev)
	go build -o bin/$(BINARY) .

build-linux:    ## Cross-compile binary for Linux (run before docker compose up --build)
	CGO_ENABLED=0 GOOS=linux go build -o bin/$(BINARY) .

help:           ## Show this help
	@grep -hE '^[a-zA-Z_-]+:.*##' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*##"}; {printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}'
