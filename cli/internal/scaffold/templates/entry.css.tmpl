body {
  font-family: system-ui, -apple-system, sans-serif;
  max-width: 40rem;
  margin: 2rem auto;
  padding: 0 1rem;
  line-height: 1.6;
  color: #1a1a1a;
}

h1, h2, h3 {
  line-height: 1.25;
}

.card-block {
  border-left: 3px solid #888;
  padding-left: 0.75rem;
  margin: 1rem 0;
}

.card-block--expanded {
  margin-left: 1.5rem;
  border-left-color: #bbb;
}

.clipboard-link {
  cursor: pointer;
  text-decoration: underline dotted;
}

.clipboard-link--copied {
  text-decoration-style: solid;
  color: #2a7a2a;
}

.clipboard-link--no-card {
  color: #888;
  font-style: italic;
}
