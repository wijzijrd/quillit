# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# ── Initial admin account (seeded on first launch) ────────────────────────────
SEED_ADMIN_EMAIL=admin@quillit.local
SEED_ADMIN_PASSWORD=changeme

# ── MinIO blob storage ────────────────────────────────────────────────────────
MINIO_USER=quillit
MINIO_PASSWORD=replace-with-strong-password

# ── Network ─────────────────────────────────────────────────────────────────────
# HTTP:                     http://YOUR_SERVER_IP:8080
# HTTPS (public domain):    https://your.domain.com
# HTTPS (LAN, self-signed): https://YOUR_SERVER_LAN_IP  (see Caddyfile.internal.example)
CORS_ORIGIN=http://localhost:8080

# Set to true when serving over HTTPS (either mode above)
COOKIE_SECURE=false

# Address(es) Caddy serves under LAN self-signed HTTPS — a stable LAN IP and/or
# <hostname>.local alias, comma-separated. Only read by docker-compose.caddy.yml;
# see Caddyfile.internal.example.
CADDY_HOST=192.168.1.50, quillit.local

# ── Log aggregation (optional — docker-compose.logging.yml) ───────────────────
# Only used if you start with -f docker-compose.logging.yml. See README.
LOKI_RETENTION_DAYS=14
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
